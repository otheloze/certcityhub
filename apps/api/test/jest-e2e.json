{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@examproject/shared-types$": "<rootDir>/../../packages/shared-types/src/index.ts"
  },
  "globalSetup": "<rootDir>/test/setup/global-setup.ts",
  "testEnvironment": "node",
  "testTimeout": 180000
}
