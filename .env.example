# --- apps/api/.env ---
# Supabase Postgres connection strings for the DEV project.
# DATABASE_URL = pooled connection (PgBouncer, port 6543) - used by the running app.
# DIRECT_URL   = direct connection (port 5432) - used by Prisma migrations.
DATABASE_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Secret used to sign JWTs. Generate a long random string for real use.
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"

PORT=3001

# Seed script login password for the demo admin/student accounts (dev only).
SEED_PASSWORD="ChangeMe123!"

# Outbound transactional email (welcome email, admin new-member notification,
# password reset codes), via Resend (https://resend.com).
RESEND_API_KEY=""
MAIL_FROM_ADDRESS="CertCityHub <no-reply@certcityhub.com>"
# Optional override - defaults to info@certcityhub.com if unset.
ADMIN_NOTIFICATION_EMAIL="info@certcityhub.com"

# PayPal checkout (developer.paypal.com -> Apps & Credentials -> your app).
# Use the Sandbox Client ID/Secret for dev; swap for the Live ones in
# production. PAYPAL_CLIENT_ID is also read client-side as
# NEXT_PUBLIC_PAYPAL_CLIENT_ID below - it's meant to be public. The secret
# must stay server-only.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# --- apps/api/.env.test (dedicated test/CI Supabase project) ---
# TEST_DATABASE_URL="postgresql://postgres:<password>@<test-project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# TEST_DIRECT_URL="postgresql://postgres:<password>@db.<test-project-ref>.supabase.co:5432/postgres"

# --- apps/web/.env.local ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
# Same value as PAYPAL_CLIENT_ID above - safe to expose, PayPal's JS SDK
# needs it in the browser.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
